{
    "id": "SimAgent",
    "modules": [
        {
            "module_id": "Ag1Com",
            "type": "local_broadcast"
        },
        {
            "module_id": "room",
            "type": "simulator",
            "model": {
                "type": {"file": "mpc_and_sim/simple_model.py", "class_name": "BaselineMPCModel"},
                "states": [{"name": "T", "value": 298}]
            },
            "t_sample_communication":  10,
            "t_sample_simulation": 10,
            "save_results": true,
            "result_filename": "results/sim_room.csv",
            "overwrite_result_file": true,
            "outputs": [
                {"name": "T_out", "alias": "T"},
                {"name": "P_el","alias": "P_el_sim"},
                {
                    "name": "eta_heater",
                    "alias": "eta_heater",
                    "value": 1
                }
            ],
            "inputs": [
                {"name": "mDot", "value": 0.02, "alias": "mDot"}
            ]
        }
    ]
}