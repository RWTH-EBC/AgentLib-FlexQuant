        },
        {
          "name": "T_Air_lb_shadow",
          "alias": "Building_1_flex_T_Air_lb_shadow"
        },
        {
          "name": "T_Air_ub",
          "alias": "Building_1_flex_T_Air_ub"
        },
        {
          "name": "T_Air_ub_sim",
          "alias": "Building_1_flex_T_Air_ub_sim"
        },
        {
          "name": "T_Air_ub_shadow",
          "alias": "Building_1_flex_T_Air_ub_shadow"
        }
